<Window x:Class="AshlapovCalculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AshlapovCalculator.Wpf"
        Title="Ashlapov Calculator — Ашлапов Иван, ИПс-21"
        Width="900" Height="760" MinWidth="760" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource DisplayForeground}"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        PreviewTextInput="Window_PreviewTextInput" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext><local:MainViewModel /></Window.DataContext>
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,22">
            <StackPanel>
                <TextBlock Text="ПРАКТИЧЕСКАЯ РАБОТА 02" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryForeground}" />
                <TextBlock Text="Калькулятор" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Ashlapov" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="Ашлапов Иван · ИПс-21" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource SecondaryForeground}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="#193F39" CornerRadius="12" Padding="20,16" Margin="4,0,4,14">
                    <StackPanel>
                        <TextBlock Text="ВЫРАЖЕНИЕ" FontSize="10" Foreground="#B5D1C5" />
                        <Viewbox Height="30" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="0,5,0,4">
                            <TextBlock Text="{Binding Expression}" FontSize="24" Foreground="#D7E8DF" />
                        </Viewbox>
                        <Viewbox Height="58" StretchDirection="DownOnly" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Result}" FontSize="48" FontWeight="SemiBold" Foreground="White" />
                        </Viewbox>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFD5BC" TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource FunctionButton}" Command="{Binding ClearCommand}" ToolTip="Очистить выражение (Esc)" AutomationProperties.Name="Очистить выражение (Esc)" />
                    <Button Grid.Row="0" Grid.Column="1" Content="(" Style="{StaticResource FunctionButton}" Command="{Binding AddSymbolCommand}" CommandParameter="(" ToolTip="Открывающая скобка" AutomationProperties.Name="Открывающая скобка" />
                    <Button Grid.Row="0" Grid.Column="2" Content=")" Style="{StaticResource FunctionButton}" Command="{Binding AddSymbolCommand}" CommandParameter=")" ToolTip="Закрывающая скобка" AutomationProperties.Name="Закрывающая скобка" />
                    <Button Grid.Row="0" Grid.Column="3" Content="⌫" Style="{StaticResource FunctionButton}" Command="{Binding BackspaceCommand}" ToolTip="Удалить символ (Backspace)" AutomationProperties.Name="Удалить символ (Backspace)" />
                    <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="7" />
                    <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="8" />
                    <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="9" />
                    <Button Grid.Row="1" Grid.Column="3" Content="÷" Style="{StaticResource OperatorButton}" Command="{Binding AddSymbolCommand}" CommandParameter="/" />
                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="4" />
                    <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="5" />
                    <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="6" />
                    <Button Grid.Row="2" Grid.Column="3" Content="×" Style="{StaticResource OperatorButton}" Command="{Binding AddSymbolCommand}" CommandParameter="*" />
                    <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="1" />
                    <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="2" />
                    <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="3" />
                    <Button Grid.Row="3" Grid.Column="3" Content="−" Style="{StaticResource OperatorButton}" Command="{Binding AddSymbolCommand}" CommandParameter="-" />
                    <Button Grid.Row="4" Grid.Column="0" Content="0" Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="0" />
                    <Button Grid.Row="4" Grid.Column="1" Content="," Style="{StaticResource CalcButton}" Command="{Binding AddSymbolCommand}" CommandParameter="," ToolTip="Десятичный разделитель" AutomationProperties.Name="Десятичный разделитель" />
                    <Button Grid.Row="4" Grid.Column="2" Content="^" Style="{StaticResource OperatorButton}" Command="{Binding AddSymbolCommand}" CommandParameter="^" ToolTip="Возведение в степень" AutomationProperties.Name="Возведение в степень" />
                    <Button Grid.Row="4" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}" Command="{Binding AddSymbolCommand}" CommandParameter="+" />
                    <Button Grid.Row="5" Grid.ColumnSpan="4" Content="=" Style="{StaticResource EqualsButton}" ToolTip="Вычислить (Enter или =)" Command="{Binding CalculateCommand}" />
                </Grid>
            </Grid>
            <Border Grid.Column="2" BorderBrush="#D5DFDB" BorderThickness="1,0,0,0" Padding="22,2,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="История" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Нажмите на запись, чтобы вернуться к выражению." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryForeground}" Margin="0,7,0,18" />
                    <TextBlock Grid.Row="2" Text="Здесь появятся ваши вычисления. История хранится, пока открыта программа." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource SecondaryForeground}" Margin="0,8,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding History}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HistoryButton}" Command="{Binding DataContext.UseHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Expression}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryForeground}" />
                                            <TextBlock Text="{Binding Result, StringFormat='= {0}'}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,14,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding History.Count, StringFormat='Записей: {0} / 20'}" FontSize="11" Foreground="{StaticResource SecondaryForeground}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Очистить" Command="{Binding ClearHistoryCommand}" Style="{StaticResource FunctionButton}" FontSize="12" Padding="10,6" Margin="4,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="Enter  вычислить     Esc  очистить     Backspace  удалить символ" Foreground="{StaticResource SecondaryForeground}" FontSize="11" Margin="4,18,0,0" />
    </Grid>
</Window>
